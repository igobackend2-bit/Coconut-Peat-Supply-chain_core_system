# Copy to .env (gitignored) and fill in real values. NEVER commit .env.
# Read by docker-compose.yml and plugin.sh.

# --- MQTT broker used by the core and grading services
MQTT_BROKER=ssl://<your-broker-host>:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Docker Hub, used by plugin.sh to push plugin images.
# Use an access token (Docker Hub > Account settings > Security), not your account password.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# --- Blockchain shipment tracking (server/blockchain.go)
# Hex private key of the sending account. Use a dedicated account, never a personal wallet.
BLOCKCHAIN_PRIVATE_KEY=
