# See docs/environment.md for the full, documented variable list.
# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Plain self-hosted PostgreSQL connection string (ADR-002).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coco_pith_factory

# Browser origins allowed to call the API (comma-separated). Defaults to the local Vite dev server.
# In production set this to the real web app origin(s), e.g. https://factory.example.com
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops in front of the API, so rate limiting sees the real client IP.
# Leave UNSET when the API is reached directly — setting it wrongly lets clients spoof their IP.
# TRUST_PROXY=1

# Rate limits, per client IP per minute. Defaults shown.
# RATE_LIMIT=600
# AUTH_RATE_LIMIT=10
